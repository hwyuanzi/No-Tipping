#!/bin/sh
set -eu

compiler=${CXX:-g++}
command -v "$compiler" >/dev/null 2>&1 || {
    echo "C++ sample requires a C++17 compiler (set CXX or install g++)." >&2
    exit 127
}
tmp=bot.tmp.$$
trap 'rm -f "$tmp"' EXIT HUP INT TERM
"$compiler" -std=c++17 -O2 bot.cpp -o "$tmp"
mv "$tmp" bot
trap - EXIT HUP INT TERM
